# Required
LUBELOGGER_URL=http://lubelogger:8080
LUBELOGGER_API_KEY=

# Strongly recommended: protect the MCP endpoint (>= 16 chars). Generate with: openssl rand -hex 24
MCP_AUTH_TOKEN=

# Endpoint path. If you expose this beyond your LAN and the client can't send a bearer token,
# use a long random path instead, e.g. /mcp/3f9c1d7a0b4e48f5a6c2d9e18b7f0a34
MCP_PATH=/mcp

# Optional
PORT=3000
HOST=0.0.0.0
CONFIRM_TTL_MINUTES=30
REQUEST_TIMEOUT_MS=15000
