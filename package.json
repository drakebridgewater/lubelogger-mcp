{
  "name": "lubelogger-mcp",
  "version": "0.1.0",
  "description": "MCP server (Streamable HTTP) that logs service, repair, fuel and odometer records into LubeLogger, with a confirm-before-write flow.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
